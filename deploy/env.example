# Copy to /opt/weex-moon/.env and fill in. Never commit the real file.
# (systemd EnvironmentFile: no comments on the same line as a value)

TELEGRAM_BOT_TOKEN=
# Your chat-ID from /whoami; comma-separated for more chats
ALERT_CHAT_IDS=
ALERTS_FROM_SCANNER=1
# A = strictest; B also sends setups with 1-2 warnings
ALERT_MIN_QUALITY=A
# Long random string; enables /api/positions tracking. Empty = disabled
APP_ACCESS_TOKEN=
SCAN_INTERVAL_SECONDS=60
SCAN_OFFSET_SECONDS=3
# Your real WEEX taker fee x2 (assumption until you check your fee tier)
PAPER_FEE_PCT_ROUNDTRIP=0.12
PAPER_SLIPPAGE_PCT=0.03
PAPER_LATENCY_SECONDS=20
